{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nebulis-push-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Reachable only on its own hostname. No *.workers.dev address and no preview URLs,
  // so there is exactly one public door to protect.
  "workers_dev": false,
  "preview_urls": false,
  // Deploying creates the DNS record for this name in the nebulis.app zone.
  "routes": [{ "pattern": "push.nebulis.app", "custom_domain": true }],

  "vars": {
    // The only app this relay will push to. Apple refuses a token that belongs to another app.
    "APNS_TOPIC": "com.nebulis.app"
  },

  // Secrets are set with `wrangler secret put`, never in this file. Naming them here makes a deploy
  // without them fail and gives `wrangler types` their names. See README.md.
  "secrets": { "required": ["APNS_KEY_P8", "APNS_KEY_ID", "APNS_TEAM_ID", "CREDENTIAL_SECRET"] },

  // Throttles. Counters are per Cloudflare location and eventually consistent: a brake, not accounting.
  "ratelimits": [
    { "name": "REGISTER_IP_LIMIT", "namespace_id": "7101", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUSH_IP_LIMIT", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUSH_TOKEN_LIMIT", "namespace_id": "7103", "simple": { "limit": 10, "period": 60 } }
  ],

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
