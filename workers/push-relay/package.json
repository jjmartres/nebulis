{
  "name": "nebulis-push-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Relays Nebulis alerts to iPhones through Apple's push service. Stateless: it stores nothing.",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.36.0"
  }
}
